# ==============================================================================
# VARIABLES DE ENTORNO (SERVIDOR BACKEND) - ROYAL TEAM CHESS
# ==============================================================================

# Puerto de red para la API Express y servidor Socket.IO
PORT=3000

# Parámetros de conexión a Supabase (BaaS) con rol de servicio autoritativo
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_supabase_service_role_key

# Token secreto requerido para endpoints de administración (/api/admin/*)
ADMIN_SECRET=tu_clave_secreta_de_admin

# Parámetros de transporte SMTP para notificaciones por email
EMAIL_USER=contact@tudominio.com
EMAIL_PASS=tu_password_smtp
SMTP_HOST=mail.tudominio.com
SMTP_PORT=465

# Pasarela de pagos y facturación Stripe (Pilar 6 - Monetización)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_PRO=price_...
