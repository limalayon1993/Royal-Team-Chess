# ==============================================================================
# VARIABLES DE ENTORNO (RAÍZ / GLOBAL) - ROYAL TEAM CHESS
# ==============================================================================

# Puerto de escucha del servidor Express y Socket.IO
PORT=3000

# Conexión autoritativa a Supabase PostgreSQL (Backend)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_supabase_service_role_key

# Clave secreta para endpoints administrativos (cabecera x-admin-secret)
ADMIN_SECRET=tu_clave_secreta_de_admin

# Configuración del servidor de correo SMTP para soporte
EMAIL_USER=contact@tudominio.com
EMAIL_PASS=tu_password_smtp
SMTP_HOST=mail.tudominio.com
SMTP_PORT=465
