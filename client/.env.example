# ==============================================================================
# VARIABLES DE ENTORNO (CLIENTE FRONTEND VITE) - ROYAL TEAM CHESS
# ==============================================================================

# URL de la API REST y canales Realtime de Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (restringida por RLS en la base de datos)
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key

# URL del servidor backend Node.js / Socket.IO (ej. http://localhost:3000 o dominio en producción)
VITE_SERVER_URL=http://localhost:3000

# Clave de API de Builder.io (opcional para CMS visual)
VITE_BUILDER_API_KEY=tu_builder_key_opcional
